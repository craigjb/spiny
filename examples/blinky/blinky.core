CAPI=2:
name: craigjb:spiny:blinky:0
description: Blinky example

filesets:
  xdc_nexys_a7:
    files:
      - data/nexys_a7_a100t.xdc
    file_type: xdc

  xdc_nexys_video:
    files:
      - data/nexys_video.xdc
    file_type: xdc

  vivado_settings:
    files:
      - data/vivado_settings.tcl
    file_type: tclSource

  dep:
    depend:
      - craigjb:spiny:generators:0.1.0

generate:
  svd:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.blinky.TopLevelVerilog
      project: blinky

  rustpac:
    generator: rustpac
    parameters:
      crate_name: blinky-pac
      crate_version: 0.1.0
      output_path: "target/rust/blinky-pac"

  firmware:
    generator: cargo
    parameters:
      project_dir: "rust"
      args:
        - "objcopy"
        - "--release"
        - "--"
        - "-O"
        - "binary"
        - "target/release/blinky.bin"

  spinalsim:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.blinky.TopLevelSim
      project: blinky
      output_path: "target/spinal/Blinky.v"
      file_type: verilogSource
   
  spinalhdl:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.blinky.TopLevelVerilog
      project: blinky
      output_path: "target/spinal/Blinky.v"
      file_type: verilogSource

targets:
  sim:
    filesets: [dep]
    generate:
        - svd
        - rustpac
        - firmware
        - spinalsim:
            args:
              - "rust/target/release/blinky.bin"
    toplevel: Blinky
    flow: generic # dummy flow
    flow_options: # only lint, sim is done with SpinalHDL
      tool: verilator 
      mode: lint-only
      verilator_options:
        - "-Wno-WIDTH"

  nexys_a7_100t:
    filesets: [xdc_nexys_a7, vivado_settings, dep]
    generate:
      - svd:
          args:
            - "--num-leds"
            - "16"
            - "--num-switches"
            - "16"
      - rustpac
      - firmware
      - spinalhdl:
          args:
            - "--num-leds"
            - "16"
            - "--num-switches"
            - "16"
            - "--firmware"
            - "rust/target/release/blinky.bin"
    toplevel: Blinky
    flow: vivado
    flow_options:
      part: xc7a100t-csg324-1

  nexys_video:
    filesets: [xdc_nexys_video, vivado_settings, dep]
    generate:
      - svd:
          args:
            - "--num-leds"
            - "8"
            - "--num-switches"
            - "8"
      - rustpac
      - firmware
      - spinalhdl:
          args:
            - "--num-leds"
            - "8"
            - "--num-switches"
            - "8"
            - "--firmware"
            - "rust/target/release/blinky.bin"
    toplevel: Blinky
    flow: vivado
    flow_options:
      part: xc7a200t-sbg484-1
