CAPI=2:
name: craigjb:spiny:ddrtest:0
description: DDR memory example

filesets:
  nexys_a7_xdc:
    files:
      - data/nexys_a7_100t/nexys_a7_100t.xdc
    file_type: xdc

  nexys_video_xdc:
    files:
      - data/nexys_video/nexys_video.xdc
    file_type: xdc

  vivado_settings:
    files:
      - data/vivado_settings.tcl
    file_type: tclSource

  dep:
    depend:
      - craigjb:spiny:generators:0.1.0

generate:
  litedram_sim:
    generator: litedram
    parameters:
      sim: yes
      verilog_output_path: "target/litedram/Ddr3Ctrl.v"
      svd_output_path: "target/litedram/Ddr3Ctrl.svd"

  spinalsim:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.ddrtest.TopLevelSim
      project: ddrtest
      file_type: verilogSource
      args:
        - "target/litedram/Ddr3Ctrl.v"
        - "rust/target/release/ddrtest-fw.bin"

  litedram:
    generator: litedram
    parameters:
      config_file: target/spinal/litedram_config.yaml
      verilog_output_path: "target/litedram/litedram.v"

  litedram-config:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.ddrtest.TopLevelVerilog
      project: ddrtest

  svd:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.ddrtest.TopLevelVerilog
      project: ddrtest

  rustpac:
    generator: rustpac
    parameters:
      crate_name: ddrtest-pac
      crate_version: 0.1.0
      output_path: "target/rust/ddrtest-pac"
      svd_path: "target/spinal/DdrTest.svd"
      linker_script_path: "target/spinal/memory.x"

  firmware:
    generator: cargo
    parameters:
      project_dir: "rust"

  spinalhdl:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      output_path: "target/spinal/DdrTest.v"
      main: spiny.examples.ddrtest.TopLevelVerilog
      project: ddrtest
      file_type: verilogSource

targets:
  sim:
    filesets: [dep]
    generate:
      - litedram-config:
          args:
            - "sim"
      - litedram_sim:
          config_file: target/spinal/litedram_config.yaml
      - svd:
          output_path: "target/spinal/DdrTest.v"
          file_type: verilogSource
          args:
            - "--dram-svd"
            - "target/litedram/Ddr3Ctrl.svd"
            - "sim"
      - rustpac
      - firmware:
          args:
            - "objcopy"
            - "--release"
            - "--features"
            - "sim"
            - "--"
            - "-O"
            - "binary"
            - "target/release/ddrtest-fw.bin"
      - spinalsim
    toplevel: DdrTest
    flow: generic # dummy flow
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wno-COMBDLY"
        - "-Wno-CASEINCOMPLETE"
        - "-Wno-WIDTHEXPAND"
        - "-Wno-WIDTHTRUNC"
        - "-Wno-WIDTHTRUNC"

  nexys_a7_100t:
    filesets: [nexys_a7_xdc, vivado_settings, dep]
    generate:
      - litedram-config:
          args:
            - "nexys_a7"
      - litedram:
          config_file: target/spinal/litedram_config.yaml
          verilog_output_path: "target/litedram/Ddr2Ctrl.v"
          svd_output_path: "target/litedram/Ddr2Ctrl.svd"
      - svd:
          args:
            - "--dram-svd"
            - "target/litedram/Ddr2Ctrl.svd"
            - "nexys_a7"
      - rustpac
      - firmware:
          args:
            - "objcopy"
            - "--release"
            - "--features"
            - "nexys_a7_100t"
            - "--"
            - "-O"
            - "binary"
            - "target/release/ddrtest-fw.bin"
      - spinalhdl:
          args:
            - "--firmware"
            - "rust/target/release/ddrtest-fw.bin"
            - "--dram-svd"
            - "target/litedram/Ddr2Ctrl.svd"
            - "nexys_a7"
    toplevel: DdrTest
    flow: vivado
    flow_options:
      part: xc7a100t-csg324-1

  nexys_video:
    filesets: [nexys_video_xdc, vivado_settings, dep]
    generate:
      - litedram-config:
          args:
            - "nexys_video"
      - litedram:
          config_file: target/spinal/litedram_config.yaml
          verilog_output_path: "target/litedram/Ddr3Ctrl.v"
          svd_output_path: "target/litedram/Ddr3Ctrl.svd"
      - svd:
          args:
            - "--dram-svd"
            - "target/litedram/Ddr3Ctrl.svd"
            - "nexys_video"
      - rustpac
      - firmware:
          args:
            - "objcopy"
            - "--release"
            - "--features"
            - "nexys_video"
            - "--"
            - "-O"
            - "binary"
            - "target/release/ddrtest-fw.bin"
      - spinalhdl:
          args:
            - "--firmware"
            - "rust/target/release/ddrtest-fw.bin"
            - "--dram-svd"
            - "target/litedram/Ddr3Ctrl.svd"
            - "nexys_video"
    toplevel: DdrTest
    flow: vivado
    flow_options:
      part: xc7a200t-sbg484-1
