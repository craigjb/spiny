CAPI=2:
name: craigjb:spiny:ddrtest:0.1.0
description: DDR memory example

filesets:
  nexys_a7_xdc:
    files:
      - data/nexys_a7_100t.xdc
    file_type: xdc

  nexys_video_xdc:
    files:
      - data/nexys_video.xdc
    file_type: xdc

  vivado_settings:
    files:
      - data/vivado_settings.tcl
    file_type: tclSource

  dep:
    depend:
      - craigjb:spiny:generators:0.1.0

generate:
  litedram_sim:
    generator: litedram
    parameters:
      config_file: data/Ddr2Sim.yaml
      sim: yes
      verilog_output_path: "target/litedram/Ddr2Sim.v"

  spinalsim:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      main: spiny.examples.ddrtest.DramSim
      project: ddrtest
      output_path: "target/spinal/DdrTest.v"
      file_type: verilogSource

  litedram:
    generator: litedram
    parameters:
      # extra copy in handy spot for inspection
      # this copy is not used for build
      verilog_output_path: "target/litedram/LiteDram.v"

  spinalhdl:
    generator: spinalhdl
    parameters:
      sbt_dir: "../../"
      output_path: "target/spinal/DdrTest.v"
      main: spiny.examples.ddrtest.TopLevelVerilog
      project: ddrtest
      file_type: verilogSource

targets:
  sim:
    filesets: [dep]
    generate: [litedram_sim, spinalsim]
    toplevel: DdrTest
    flow: generic # dummy flow
    flow_options:
      tool: verilator 

  nexys_a7_100t:
    filesets: [nexys_a7_xdc, vivado_settings, dep]
    generate:
      - litedram:
          config_file: data/Ddr2Ctrl.yaml
      - spinalhdl:
          args:
            - "data/Ddr2Ctrl.yaml"
    toplevel: DdrTest
    flow: vivado
    flow_options:
      part: xc7a100t-csg324-1
